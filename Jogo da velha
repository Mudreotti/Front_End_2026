CSS
* {
  box-sizing: border-box;
}

body {
  font-family: sans-serif;
  margin: 20px;
  padding: 0;
  background-color: #f0f0f0;
  display: flex;
  justify-content: center;
}

h1 {
  margin-top: 0;
  font-size: 24px;
  text-align: center;
}

.game {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.status {
  margin-bottom: 15px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
}

.board {
  display: grid;
  grid-template-columns: repeat(3, 60px);
  grid-template-rows: repeat(3, 60px);
  gap: 2px;
  background-color: #999;
  padding: 2px;
  border-radius: 4px;
}

.square {
  background: #312c2c;
  color: #fff;
  border: none;
  font-size: 32px;
  font-weight: bold;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.square:hover {
  background: #453e3e;
}

#reset-btn {
  padding: 10px 20px;
  font-size: 16px;
  font-weight: bold;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

#reset-btn:hover {
  background-color: #0056b3;
}

javascript

const squares = document.querySelectorAll('.square');
const statusText = document.getElementById('status');
const resetBtn = document.getElementById('reset-btn');

let board = Array(9).fill(null);
let xIsNext = true;
let gameActive = true;

const winningLines = [
  [0, 1, 2], [3, 4, 5], [6, 7, 8], 
  [0, 3, 6], [1, 4, 7], [2, 5, 8], 
  [0, 4, 8], [2, 4, 6]             
];

function handleSquareClick(e) {
  const index = e.target.getAttribute('data-index');

  if (board[index] || !gameActive) return;

  board[index] = xIsNext ? 'X' : 'O';
  e.target.textContent = board[index];

  checkResult();
}

function checkResult() {
  let roundWon = false;

  for (let i = 0; i < winningLines.length; i++) {
    const [a, b, c] = winningLines[i];
    if (board[a] && board[a] === board[b] && board[a] === board[c]) {
      roundWon = true;
      break;
    }
  }

  if (roundWon) {
    statusText.textContent = `Ganhador: ${xIsNext ? 'X' : 'O'}! 🎉`;
    gameActive = false;
    return;
  }

  if (!board.includes(null)) {
    statusText.textContent = 'Empate! 🏼‍🫲🏼';
    gameActive = false;
    return;
  }

  xIsNext = !xIsNext;
  statusText.textContent = `Próximo jogador: ${xIsNext ? 'X' : 'O'}`;
}

function resetGame() {
  board = Array(9).fill(null);
  xIsNext = true;
  gameActive = true;
  statusText.textContent = 'Próximo jogador: X';
  squares.forEach(square => square.textContent = '');
}

squares.forEach(square => square.addEventListener('click', handleSquareClick));
resetBtn.addEventListener('click', resetGame);
